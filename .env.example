# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
# Optional: without a usable key the local memory backend (below) is used.
ZEP_API_KEY=your_zep_api_key_here

# ===== Memory backend =====
# auto (default): Zep Cloud when ZEP_API_KEY is a real key, else local memory.
# local: SQLite knowledge graph in this process (extraction uses the LLM above).
# zep: always Zep Cloud (ZEP_API_KEY required).
# MEMORY_BACKEND=auto
# Local memory knobs (defaults shown). Back up the store with:
#   sqlite3 backend/uploads/memory/local_memory.sqlite3 ".backup copy.sqlite3"
# LOCAL_MEMORY_DB_PATH=backend/uploads/memory/local_memory.sqlite3
# LOCAL_MEMORY_LLM_MODEL=                      # empty: use LLM_MODEL_NAME; a fast non-reasoning model builds graphs much faster
# PARTHENON_SYMPOSIUM_MODEL=                   # empty: use LLM_MODEL_NAME; a fast non-reasoning model answers in the Symposium in seconds but holds less tightly to the record
# LOCAL_MEMORY_LLM_CONCURRENCY=2
# LOCAL_MEMORY_LLM_MIN_INTERVAL_SECONDS=0      # 3.5 suits OpenRouter free models
# LOCAL_MEMORY_LLM_MAX_ATTEMPTS=3
# LOCAL_MEMORY_LLM_MAX_TOKENS=4096
# LOCAL_MEMORY_WINDOW_CHARS=4000
# LOCAL_MEMORY_MAX_ENTITIES_PER_WINDOW=30
# LOCAL_MEMORY_MAX_RELATIONS_PER_WINDOW=50
# LOCAL_MEMORY_PROMPT_KNOWN_ENTITIES=60
# LOCAL_MEMORY_PROMPT_EXISTING_FACTS=30
# LOCAL_MEMORY_MAX_FAILED_FRACTION=0.5
# LOCAL_MEMORY_DEDUP_PASS=llm                  # llm | off
# LOCAL_MEMORY_INGESTION_TIMEOUT_SECONDS=1800
# LOCAL_MEMORY_LEASE_SECONDS=180
# LOCAL_MEMORY_ACTIVITY_MODE=rules             # rules | llm | off
# LOCAL_MEMORY_ACTIVITY_GROUP_SIZE=8
# LOCAL_MEMORY_ACTIVITY_GROUP_CHARS=12000
# LOCAL_MEMORY_ACTIVITY_GROUP_WAIT_SECONDS=15
# LOCAL_MEMORY_ACTIVITY_MAX_PENDING_SECONDS=300
# LOCAL_MEMORY_ACTIVITY_MAX_LLM_CALLS=60
# LOCAL_MEMORY_SUMMARY_MAX_CHARS=800
# LOCAL_MEMORY_SEARCH_INVALID_PENALTY=0.7

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
