# Allow-list: only what the images build from reaches the Docker context.
# Everything else stays out, above all .env, parthenon.env*, backend/uploads
# (the owner's gatherings and memory) and any local virtualenv.
*

!Dockerfile
!Dockerfile.render
!LICENSE
!README.md
!package.json
!package-lock.json

!backend/pyproject.toml
!backend/uv.lock
!backend/run.py
!backend/wsgi.py
!backend/app
!backend/scripts

!bridge/grok_bridge.py
!deploy
!locales

!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/public
!frontend/scripts
!frontend/src

# Never, even inside the folders above.
**/.env
**/.env.*
**/*.env.rtf
**/__pycache__
**/*.pyc
**/.DS_Store
**/node_modules
**/.pytest_cache
deploy/tests
locales/.merge.lock
